{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "fem change item",
  "$comment": "Spec \u00a710. One proposed difference between the old and new screens.",
  "type": "object",
  "required": ["id", "type", "screen", "summary", "impact", "status"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^C-[a-z0-9-]+-[0-9]{3}$"
    },
    "type": {
      "enum": ["V0", "V1", "D1", "D2", "A1", "A2", "R1", "X"]
    },
    "screen": {
      "type": "object",
      "properties": {
        "old": {
          "type": ["string", "null"]
        },
        "new": {
          "type": ["string", "null"]
        }
      },
      "required": ["old", "new"],
      "additionalProperties": false
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "resolution": {
      "type": "string",
      "$comment": "\u00a76.2 ladder. Required for D1 and D2, omitted otherwise.",
      "pattern": "^ladder step [1-5]"
    },
    "crossCuttingRef": {
      "type": "string",
      "pattern": "^X-[0-9]{2}$"
    },
    "impact": {
      "type": "object",
      "$comment": "Every layer L1-L12 MUST be present. Use {\"change\":\"none\"} rather than omitting.",
      "required": [
        "L1",
        "L2",
        "L3",
        "L4",
        "L5",
        "L6",
        "L7",
        "L8",
        "L9",
        "L10",
        "L11",
        "L12"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^L([1-9]|1[0-2])$": {
          "type": "object",
          "required": ["change"],
          "additionalProperties": false,
          "properties": {
            "change": {
              "type": "string",
              "minLength": 1
            },
            "breaking": {
              "type": "boolean"
            },
            "affectedConsumers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "assumed": {
              "type": "boolean"
            },
            "searched": {
              "type": "string",
              "$comment": "Required when assumed is true \u2014 \u00a76.4"
            },
            "rubric": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "$comment": "fem.config.json baseSizes keys for this layer. compute-estimate.ts prices ONLY these \u2014 an empty array means this layer costs nothing here."
            },
            "blockedOnQuestion": {
              "type": "string",
              "pattern": "^Q",
              "$comment": "\u00a79.3: any blocked layer takes the change's P90 to x2.0."
            }
          }
        }
      }
    },
    "estimate": {
      "type": "object",
      "required": ["p50", "p90", "confidence"],
      "additionalProperties": false,
      "properties": {
        "p50": {
          "type": "number",
          "minimum": 0
        },
        "p90": {
          "type": "number",
          "minimum": 0
        },
        "confidence": {
          "enum": ["High", "Medium", "Low"]
        },
        "multipliersApplied": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "drivers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "required": ["bucket"],
      "additionalProperties": false,
      "properties": {
        "bucket": {
          "enum": ["Take", "Take-variant", "Defer", "Reject"]
        },
        "variant": {
          "type": "string"
        },
        "delta": {
          "type": "number"
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "status": {
      "enum": ["evidenced", "assumed", "blocked-on-question"]
    },
    "risks": {
      "type": "array",
      "items": {
        "enum": [
          "breaking_contract_with_other_consumer",
          "data_migration_large_or_hot_table",
          "payments_finance_fee_domain",
          "state_machine_change_A2"
        ]
      },
      "$comment": "\u00a79.2 multipliers. compute-estimate.ts reads this; it is not optional decoration."
    }
  }
}
